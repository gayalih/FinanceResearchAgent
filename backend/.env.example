# Required: get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model used for the agent loop
ANTHROPIC_MODEL=claude-sonnet-5

# Required by SEC EDGAR's fair-access policy: EDGAR asks every automated
# client to identify itself with a name and contact email in the User-Agent
# header (see https://www.sec.gov/os/webmaster-faq#developers). Put your own
# contact info here - do not use someone else's.
SEC_EDGAR_CONTACT="Your Name your-email@example.com"

# Port the backend listens on
PORT=4000
